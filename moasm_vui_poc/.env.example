# 复制为 .env 后填写（PyCharm 会自动加载，CLI 也会读取）
# 注意：本文件是模板，只放占位符；真实密钥写进 .env（已被 .gitignore 忽略）
TRIPNOW_API_KEY=sk-live-xxxx

# 接入方式：openapi | mcp
TRIPNOW_TRANSPORT=openapi

# 环境：prod | test
TRIPNOW_ENV=test

# 模型：tripnow-travel-pro | tripnow-voice-zh | tripnow-voice-ja
TRIPNOW_MODEL=tripnow-travel-pro

# 个人信息查询用，OAuth 获取后的用户标识；公开查询留空即可
TRIPNOW_UNION_ID=

# ── 多能力分流（chat_app.py）用，缺哪个就自动不启用对应能力 ──
# Gemini：意图分类 + 闲聊兜底（分流层硬依赖）
GEMINI_API_KEY=

# 快递100：实时查询授权 key + customer
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=
# 高德地图（key 同时适用于 REST 与 A2A 两种后端）
AMAP_KEY=
# 默认定位「经度,纬度」：CLI 无 GPS 时用它兜底（可留空=深圳）
AMAP_DEFAULT_LOC=
# 后端实现：rest（默认，Web 服务 REST，结构化可控）| a2a（旧的 ai_native 智能体，保留对比）
AMAP_BACKEND=

# 腾讯新闻：官方只提供 Skill/CLI 接入（tencent-news-cli），需先安装并配置 API Key
TENCENT_NEWS_API_KEY=
# CLI 可执行名/启动器（可留空=tencent-news-cli）；如需启动器："python run-cli.py"
TENCENT_NEWS_CLI=
# 天气默认行政区划码（可留空=440300 深圳）；自然语言通常没有 adcode 时用它兜底
TENCENT_NEWS_DEFAULT_ADCODE=

# 网易云音乐：官方 Skill/CLI 接入（@music163/ncm-cli）。两者都填才启用 music 能力。
# 凭证在 music.163.com/st/developer 实名登录后获取；运行期还需：
#   1) npm i -g @music163/ncm-cli   2) 装 mpv 播放器   3) 在服务端机器 `ncm-cli login` 扫码登录
MUSIC163_APPID=
MUSIC163_PRIVATE_KEY=
# CLI 调用方式（可留空）：Windows 自动用 node 直跑 npm 全局的 dist/index.js（绕开 .cmd 垫片）；
# mac/linux 留空=PATH 上的 ncm-cli。也可显式设为 "node /abs/path/dist/index.js"
MUSIC163_CLI=

# 分流调试日志开关：DEBUG 打印分类细节/命中技能/耗时；默认 WARNING（静默）
# chat_app.py 的 --debug 会临时覆盖为 DEBUG
ROUTING_LOG_LEVEL=WARNING

# ── client-server 模式（serve.py）─────────────────────────
# 服务端 Bearer 鉴权密钥：留空=不鉴权（仅限局域网试用）；公网/阿里云务必设置
# 客户端需在请求头带 Authorization: Bearer <该值>
SERVER_AUTH_TOKEN=
